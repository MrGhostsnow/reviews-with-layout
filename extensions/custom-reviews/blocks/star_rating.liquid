{% comment %}
  Custom Reviews Block — v2
  Fetches reviews from the app's own backend (Remix route /api/reviews)
  and renders them using 100% custom HTML/CSS, with no Judge.me widget involved.

  The block renders a loading skeleton first, then replaces it with real data
  once the fetch resolves. If the request fails, a neutral fallback message
  is shown instead of a broken UI.
{% endcomment %}

<div id="custom-reviews-{{ block.id }}" class="custom-reviews">
  <h3 class="custom-reviews__heading">Customer Reviews</h3>

  <div class="custom-reviews__grid custom-reviews__skeleton" aria-hidden="true">
    <div class="custom-reviews__card custom-reviews__card--skeleton"></div>
    <div class="custom-reviews__card custom-reviews__card--skeleton"></div>
  </div>
</div>

<style>
  .custom-reviews {
    padding: 24px 0;
    font-family: inherit;
  }
  .custom-reviews__heading {
    font-size: 18px;
    margin: 0 0 16px;
  }
  .custom-reviews__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .custom-reviews__card {
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    padding: 16px;
  }
  .custom-reviews__card--skeleton {
    min-height: 100px;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.4s infinite;
    border: none;
  }
  @keyframes shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  .custom-reviews__stars {
    color: rgba(0, 0, 0, 0.2);
    font-size: 16px;
    margin-bottom: 8px;
  }
  .custom-reviews__star--filled {
    color: #1a1a1a;
  }
  .custom-reviews__body {
    margin: 0 0 8px;
    line-height: 1.5;
  }
  .custom-reviews__author {
    font-size: 13px;
    color: rgba(0, 0, 0, 0.6);
    margin: 0;
  }
  .custom-reviews__empty {
    color: rgba(0, 0, 0, 0.5);
    font-size: 14px;
  }
</style>

<script>
  (function () {
    const container = document.getElementById("custom-reviews-{{ block.id }}");
    const grid = container.querySelector(".custom-reviews__grid");

    // TODO: replace this hardcoded origin with an App Proxy URL before going live.
    // Using the dev tunnel URL is fine for local testing only.
    const API_URL = "{{ shop.url }}/apps/reviews/api/reviews";

    function buildStars(rating) {
      return Array.from({ length: 5 }, (_, i) => {
        const filled = i < rating ? ' custom-reviews__star--filled' : '';
        return `<span class="custom-reviews__star${filled}" aria-hidden="true">★</span>`;
      }).join('');
    }

    function renderReviews(reviews) {
      if (!reviews.length) {
        grid.innerHTML = '<p class="custom-reviews__empty">No reviews yet.</p>';
        return;
      }

      grid.className = "custom-reviews__grid";
      grid.innerHTML = reviews.map((r) => `
        <div class="custom-reviews__card">
          <div class="custom-reviews__stars" aria-label="${r.rating} out of 5 stars">
            ${buildStars(r.rating)}
          </div>
          ${r.title ? `<p class="custom-reviews__title"><strong>${r.title}</strong></p>` : ""}
          <p class="custom-reviews__body">${r.body ?? ""}</p>
          <p class="custom-reviews__author">${r.reviewerName ?? "Anonymous"}</p>
        </div>
      `).join('');
    }

    fetch(API_URL)
      .then((res) => res.json())
      .then((data) => renderReviews(data.reviews ?? []))
      .catch(() => {
        grid.className = "custom-reviews__grid";
        grid.innerHTML = '<p class="custom-reviews__empty">Could not load reviews right now.</p>';
      });
  })();
</script>

{% schema %}
{
  "name": "Custom Reviews",
  "target": "section",
  "settings": []
}
{% endschema %}
